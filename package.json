{
  "name": "tongzip",
  "productName": "TongZip",
  "version": "1.0.0",
  "description": "TongZip — 现代跨平台压缩文件管理器",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json",
    "build": "vite build",
    "start": "electron dist-electron/main.js",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.tongzip.app",
    "productName": "TongZip",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "dist-electron/**/*"],
    "extraResources": { "from": "engine", "to": "engine" },
    "win": { "target": ["portable", "nsis"], "icon": "build/icon.ico" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TongZip"
    }
  }
}
