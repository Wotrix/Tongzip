{
  "name": "tongzip",
  "productName": "TongZip",
  "version": "1.0.0",
  "description": "TongZip",
  "main": "dist-electron/main.js",
  "private": true,
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.electron.json && tsc -p tsconfig.json",
    "build": "vite build",
    "start": "electron dist-electron/main.js",
    "dist": "npm run build && electron-builder --win",
    "selftest": "esbuild scripts/selftest.ts --bundle --platform=node --target=node20 --outfile=.tmp/selftest.cjs --log-level=error && node .tmp/selftest.cjs",
    "crash": "esbuild scripts/crash-test.ts --bundle --platform=node --target=node20 --outfile=.tmp/crash-test.cjs --log-level=error && node .tmp/crash-test.cjs",
    "fmt-matrix": "esbuild scripts/format-matrix.ts --bundle --platform=node --target=node20 --outfile=.tmp/format-matrix.cjs --log-level=error && node .tmp/format-matrix.cjs",
    "compat": "esbuild scripts/compat-probe.ts --bundle --platform=node --target=node20 --outfile=.tmp/compat-probe.cjs --log-level=error && node .tmp/compat-probe.cjs",
    "install-test": "esbuild scripts/install-test.ts --bundle --platform=node --target=node20 --outfile=.tmp/install-test.cjs --log-level=error && node .tmp/install-test.cjs",
    "stability": "esbuild scripts/stability.ts --bundle --platform=node --target=node20 --outfile=.tmp/stability.cjs --log-level=error && node .tmp/stability.cjs",
    "gate": "esbuild scripts/gate.ts --bundle --platform=node --target=node20 --outfile=.tmp/gate.cjs --log-level=error && node .tmp/gate.cjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.51.0",
    "radix-ui": "^1.6.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.25.12": true
  },
  "build": {
    "appId": "com.tongzip.app",
    "productName": "TongZip",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "extraResources": [
      { "from": "engine", "to": "engine" },
      { "from": "build/archive.ico", "to": "archive.ico" },
      { "from": "licenses", "to": "licenses" }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "TongZip",
      "license": "licenses/LICENSE-7-Zip.txt",
      "include": "build/uninstall.nsh"
    }
  }
}
